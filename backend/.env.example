# =============================================================================
# Trust Shield — Backend Environment Template (.env.example)
# =============================================================================
# Copy this file to backend/.env and supply your sensitive API keys.
# NEVER commit backend/.env to version control.
# =============================================================================

# Server & Network Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://trust-shield.vercel.app
FRONTEND_URL=https://trust-shield.vercel.app

# Database Configuration (SQLite default local embedded database)
TRUSTSHIELD_DB_PATH=data/trustshield.db

# Preserved Remote Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT Secret Key (Used for HMAC-SHA256 session token generation and verification)
JWT_SECRET=trustshield_replace_with_secure_random_secret_string

# Supabase Auth & Storage Integration (Optional)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# Global Cyber Threat Intelligence Providers (Live External Feeds)
# =============================================================================
# 1. OpenPhish: Public community feed active by default without key.
#    Add commercial key here if you subscribe to OpenPhish Premium feeds.
OPENPHISH_API_KEY=

# 2. Abuse.ch URLhaus: Register free at https://urlhaus.abuse.ch/api/ for an Auth-Key
URLHAUS_API_KEY=

# 3. PhishTank: Register for a developer app key at https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=

# 4. Google Safe Browsing: Cloud API v4 key from https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# 5. VirusTotal: REST API v3 key from https://www.virustotal.com/gui/user/api-key
VIRUSTOTAL_API_KEY=

# 6. AbuseIPDB: REST API v2 key from https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# 7. AlienVault OTX: Threat exchange API key from https://otx.alienvault.com/api
OTX_API_KEY=

# 8. CIRCL MISP: Threat sharing platform URL and Auth Key
MISP_URL=
MISP_AUTH_KEY=

# =============================================================================
# Operational Safety Limits & Scanner Thresholds
# =============================================================================
SCANNER_MAX_BODY_BYTES=10485760
SCANNER_MAX_REDIRECT_HOPS=5
SCANNER_MAX_CERT_CHAIN_BYTES=65536
SCANNER_DETONATION_TIMEOUT_SEC=15

# Optional Initial Administrator Account Seed (Disabled when password is empty)
INITIAL_ADMIN_EMAIL=admin@trustshield.internal
INITIAL_ADMIN_PASSWORD=
