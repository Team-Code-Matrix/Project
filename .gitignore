# ==============================================================================
# TrustShield - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 2. Build & Distribution Outputs
# ------------------------------------------------------------------------------
dist/
*/dist/
frontend/dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*/*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg-info/
*.egg
develop-eggs/
eggs/
.eggs/
parts/
sdist/
wheels/
share/python-wheels/

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
coverage.xml

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secret Files (Keep Examples)
# ------------------------------------------------------------------------------
.env
*.env
*.env.*
*.env.download
.env.local
.env.*.local
backend/.env
backend/*.env
frontend/.env
frontend/.env.local
frontend/*.env.*

# Explicitly track documented templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 5. Local Databases & Runtime Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
!backend/data/.gitkeep

# ------------------------------------------------------------------------------
# 6. Large Machine Learning Checkpoints (Keep Pre-Trained Model & Metadata)
# ------------------------------------------------------------------------------
*.h5
*.pt
*.pth
*.bin
*.weights
*.ckpt

# Keep core custom trained phishing model & metadata tracked
!backend/ml/models/trustshield_phishing_model.joblib
!backend/ml/models/model_metadata.json

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# 8. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
